{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/auth"
          }
        ],
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/catalog"
          }
        ],
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/orders"
          }
        ],
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "enrollment-route": {
        "ClusterId": "enrollment-cluster",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/enrollments"
          }
        ],
        "Match": {
          "Path": "/api/enrollments/{**catch-all}"
        }
      },
      "filestorage-route": {
        "ClusterId": "file-cluster",
        "Transforms": [
          {
            "PathRemovePrefix": "/api/file-storage"
          }
        ],
        "Match": {
          "Path": "/api/file-storage/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://auth-service:8080/"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "catalog-destination": {
            "Address": "http://catalog-service:8080/"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-destination": {
            "Address": "http://order-service:8080/"
          }
        }
      },
      "enrollment-cluster": {
        "Destinations": {
          "enrollment-destination": {
            "Address": "http://enrollment-service:8080/"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file-destination": {
            "Address": "http://file-storage-service:8080/"
          }
        }
      }
    }
  }
}
